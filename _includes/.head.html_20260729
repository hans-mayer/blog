<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% if page.title %}{{ page.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="viewport" content="width=device-width">
    <meta name="description" content="{{ site.description }}">
    <link rel="canonical" href="{{ page.url | replace:'index.html','' | prepend: site.baseurl | prepend: site.url }}">
    <link rel="icon" href="/images/m16.png" type="image/png">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ "/css/main.css" | prepend: site.baseurl }}">


<style>

/* Grundlegende Lesbarkeit für den Fließtext */
  body {
      font-size: 18px;         /* Standard ist oft 16px - 18px erhöht die Lesbarkeit deutlich */
      line-height: 1.6;        /* Ausreichender Zeilenabstand für bessere Orientierung */
      color: #111111;          /* Sehr dunkles Grau auf weißem Grund ergibt ein Kontrastverhältnis von ~18:1 (weit über 4,5:1) */
      background-color: #ffffff;
  }

  /* Der pre-Container muss relativ sein */
  pre, code {
      position: relative;
      padding-top: 30px; 
      font-size: 15px;         /* Monospace-Schriften wirken oft etwas größer, daher 15-16px */
      background-color: #f4f4f4; /* Hellgrauer Hintergrund */
      color: #1a1a1a;          /* Dunkler Text für maximalen Kontrast */
  }

  .copy-code-button {
      position: absolute;
      top: 5px;
      right: 5px;
      background: #222222;
      color: #ffffff;            /* Weißer Text = Kontrast 15.3:1 (AA & AAA konform) */
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 4px 10px;
      cursor: pointer;
      font-size: 13px;
      z-index: 10; /* Damit der Button über dem Code liegt */
  }

  .copy-code-button:hover {
      background: #000000;
  }

  a {
      color: #0056b3; /* Kontrast ca. 7:1 auf weiß */
      text-decoration: underline; /* Unterstreichung hilft zusätzlich bei Barrierefreiheit */
  }

  /* 1. Beitrags-Metadaten (Datum, Autor etc.) */
  .meta,
  .post-meta {
      color: #555555 !important; /* Kontrast 7.4:1 auf Weiß (erfüllt AA und AAA) */
  }
  
  /* 2. Erster Punkt im Footer (Linke Spalte) */
  .footer-col-1 > ul > li:nth-child(1),
  .site-footer {
      color: #444444 !important; /* Kontrast 9.8:1 auf Weiß */
  }
  
  /* Links im Footer ebenfalls abdunkeln, falls vorhanden */
  .site-footer a,
  .footer-col-1 a {
      color: #0056b3 !important; /* Kontrast 7:1 auf Weiß */
  }
  
  /* 3. Alle Elemente mit der Klasse .text */
  .text {
      color: #222222 !important; /* Kontrast 15.3:1 auf Weiß */
  }

</style>

</head>
